# Set APP_ENV=production in production deployments. The API requires DATABASE_URL
# and JWT_SECRET there; use deployment-managed secrets rather than these examples.
APP_ENV=development

# API data services
DATABASE_URL=sqlite:///./finadvisor.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-value
INTERNAL_API_KEY=replace-with-a-random-value

# Web authentication; provider credentials are optional until sign-in is enabled.
NEXTAUTH_SECRET=replace-with-a-random-value
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Email integration (disabled until configured).
EMAIL_PROVIDER=disabled
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# Payment integration (disabled until configured).
PAYMENT_PROVIDER=disabled
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional monitoring.
SENTRY_DSN=

# API origins used by the web server and browser respectively.
FINADVISOR_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
